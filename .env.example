# ==============================================================================
# RazorFlow Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development.
# 2. Never commit actual secret keys or '.env' files to version control.
# 3. For Supabase PostgreSQL, copy the connection URI from Project Settings -> Database.
# 4. For Managed Redis (e.g. Upstash), copy the rediss:// connection URI.
# 5. RazorFlow strictly defaults to Razorpay TEST MODE for buildathon safety.
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & RUNTIME SETTINGS
# ==============================================================================
# Options: development | staging | production | test
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=RazorFlow-API

# API Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated for multiple origins)
# For local dev: http://localhost:3000,http://127.0.0.1:3000
# For production: https://razorflow.yourdomain.com,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Cryptographic Keys (Min 32 characters for security)
SECRET_KEY=change-this-in-production-super-secret-key-32chars
ENCRYPTION_KEY=32-bytes-base64-encoded-key-for-credentials-storage

# ==============================================================================
# 2. POSTGRESQL / SUPABASE DATABASE
# ==============================================================================
# Local Development (Docker / Local PostgreSQL):
POSTGRES_USER=razorflow
POSTGRES_PASSWORD=razorflow_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=razorflow_db
DATABASE_URL=postgresql+asyncpg://razorflow:razorflow_dev_password@localhost:5432/razorflow_db
DATABASE_SYNC_URL=postgresql://razorflow:razorflow_dev_password@localhost:5432/razorflow_db

# Production Supabase Connection Strings (Example Format):
# - Session Mode (Port 5432):
#   DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?ssl=require
# - Transaction Pooler Mode (Port 6543 / Supavisor / PgBouncer):
#   DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# ==============================================================================
# 3. REDIS & CELERY TASK QUEUE
# ==============================================================================
# Local Development (Docker / Local Redis):
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Production Managed Redis / Upstash (Example TLS Format):
# REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379/0
# CELERY_BROKER_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379/1
# CELERY_RESULT_BACKEND=rediss://default:[PASSWORD]@[HOST].upstash.io:6379/2

# ==============================================================================
# 4. GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
# Obtain from Google AI Studio (https://aistudio.google.com/)
# Backend-only secret. NEVER expose to the frontend.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=8.0
AI_ENABLED=true
AI_PROMPT_VERSION=v1.0.0

# ==============================================================================
# 5. RAZORPAY TEST MODE CONFIGURATION
# ==============================================================================
# SAFETY INVARIANT: RAZORPAY_MODE must be 'test'.
# RAZORPAY_PRODUCTION_ENABLED must remain 'false' to prevent live charges.
RAZORPAY_MODE=test
RAZORPAY_PRODUCTION_ENABLED=false

# Obtain Test API Keys from Razorpay Dashboard (Settings -> API Keys in Test Mode)
# Format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Configured in Razorpay Webhooks Dashboard for HMAC-SHA256 signature verification
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ==============================================================================
# 6. FRONTEND WEB CONFIGURATION (Next.js)
# ==============================================================================
# Exposed to the browser bundle via NEXT_PUBLIC_ prefix
# For local dev: http://localhost:8000/api/v1
# For production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ==============================================================================
# 7. OBSERVABILITY & TELEMETRY (Optional)
# ==============================================================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
